# DreamWeave Environment Configuration Example
# Copy to brain/.env or workspace root .env

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=DreamWeave
MONGODB_DATABASE=dreamweave

# Gemini API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Pretrained Embedding Model Configuration
# Model produce 384-dimensional vector embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# RAG & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=5

# Environment Mode (development | production | test)
ENVIRONMENT=development

# JWT Authentication Configuration
# Generate a strong 64-character hex secret using:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Or:
#   openssl rand -hex 32
# NOTE: In production (ENVIRONMENT=production), the application will refuse to start
# if JWT_SECRET_KEY is missing, uses a known placeholder, or is shorter than 32 characters.
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Comma-separated list of allowed frontend URLs (no trailing slashes, no wildcard * when credentials enabled)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# DreamWeave Environment Configuration Example
# Copy to brain/.env or workspace root .env

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=DreamWeave
MONGODB_DATABASE=dreamweave

# Gemini API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Pretrained Embedding Model Configuration
# Model produce 384-dimensional vector embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# RAG & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=5
